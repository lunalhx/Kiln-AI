<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>cn.lunalhx.ai</groupId>
    <artifactId>kiln-ai</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Kiln-AI</name>
    <description>A learning system for durable and independent capability.</description>

    <modules>
        <module>kiln-ai-types</module>
        <module>kiln-ai-domain</module>
        <module>kiln-ai-infrastructure</module>
        <module>kiln-ai-api</module>
        <module>kiln-ai-trigger</module>
        <module>kiln-ai-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-spring-boot.version>4.0.1</mybatis-spring-boot.version>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.lunalhx.ai</groupId>
                <artifactId>kiln-ai-types</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.lunalhx.ai</groupId>
                <artifactId>kiln-ai-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.lunalhx.ai</groupId>
                <artifactId>kiln-ai-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.lunalhx.ai</groupId>
                <artifactId>kiln-ai-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.lunalhx.ai</groupId>
                <artifactId>kiln-ai-trigger</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
