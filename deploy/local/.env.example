# Copy to deploy/local/.env and fill OPENAI_API_KEY with an OpenAI-compatible key:
#   cp deploy/local/.env.example deploy/local/.env
#
# Docker Compose, the app, and the optional live smoke test all read
# deploy/local/.env. Regular tests do not.
# Strong and Small both use OpenCode Go deepseek-v4-flash (OpenAI-compatible chat completions).
# Endpoint is the host only; Spring AI appends /v1/chat/completions.

KILN_DB_NAME=kiln_ai
KILN_DB_USERNAME=kiln_ai
KILN_DB_PASSWORD=kiln_ai
KILN_DB_PORT=5432

OPENAI_API_KEY=

kiln.catalog.strong=opencode-go/deepseek-v4-flash
kiln.catalog.small=opencode-go/deepseek-v4-flash
kiln.catalog.providers[0].provider-id=opencode-go
kiln.catalog.providers[0].protocol=openai-compatible
kiln.catalog.providers[0].endpoint=https://opencode.ai/zen/go
kiln.catalog.providers[0].secret-env-var=OPENAI_API_KEY
kiln.catalog.providers[0].models[0]=deepseek-v4-flash
